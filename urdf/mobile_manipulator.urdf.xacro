<?xml version="1.0"?>
<!--
  移动抓取机器人：差速底盘 my_car + Franka Panda 七自由度机械臂。

  控制划分（互不重叠，因此不会抢同一个关节）：
    * 左/右轮：gazebo_ros_diff_drive 插件（cmd_vel / odom），沿用 my_car.urdf。
    * 机械臂 + 夹爪：gazebo_ros2_control -> controller_manager ->
      panda_arm_controller / panda_hand_controller。

  轮子没有写进 <ros2_control>，机械臂也没有写进差速插件，所以两套控制
  可以同时运行。轮子的 /joint_states 由 my_car.urdf 里的
  gazebo_ros_joint_state_publisher 发布，Panda 的由 joint_state_broadcaster
  发布，二者合并在同一个 /joint_states 话题上。
-->
<robot name="mobile_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= 1. 原有差速底盘（原样复用） ================= -->
  <xacro:include filename="$(find my_robot_sim)/urdf/my_car.urdf"/>

  <!-- ================= 2. 机械臂安装板 ================= -->
  <!-- base_link 是 0.4 x 0.25 x 0.05 的盒子，顶面在 z=+0.025。
       安装板厚 0.01，中心放在 z=0.03，顶面正好 z=0.035。
       机械臂略靠后（x=-0.04），让伸臂时的重心仍落在轮轴与万向轮之间。 -->
  <link name="arm_mount_link">
    <visual>
      <geometry><box size="0.12 0.12 0.01"/></geometry>
      <material name="mount_gray"><color rgba="0.35 0.35 0.35 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.12 0.12 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000242" iyy="0.000242" izz="0.000480"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount_link"/>
    <origin xyz="-0.04 0 0.03"/>
  </joint>

  <!-- ================= 3. 底盘配重（电池包） ================= -->
  <!-- 原来的车只有约 1.6 kg，Panda 即使按 10% 质量缩放也有约 1.7 kg。
       臂伸到前方 0.5 m 时若没有配重，重心会越过驱动轮（x=+0.1）导致翻车。
       这块 2.5 kg 的电池包挂在车底，把重心拉回支撑多边形内。 -->
  <link name="ballast_link">
    <visual>
      <geometry><box size="0.30 0.20 0.06"/></geometry>
      <material name="battery_dark"><color rgba="0.15 0.15 0.18 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.30 0.20 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.009083" iyy="0.019500" izz="0.027083"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="ballast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ballast_link"/>
    <!-- 车底板在 z=-0.025，电池包顶面也放在 z=-0.025 -->
    <origin xyz="-0.05 0 -0.055"/>
  </joint>

  <!-- ================= 4. Panda 机械臂（带 Gazebo 惯量） ================= -->
  <xacro:include filename="$(find my_robot_sim)/urdf/panda_with_inertia.urdf.xacro"/>

  <!-- panda_link0 原点位于臂座底面，安装板顶面是 z=0.035 -->
  <joint name="panda_base_joint" type="fixed">
    <parent link="arm_mount_link"/>
    <child link="panda_link0"/>
    <origin xyz="0 0 0.005"/>
  </joint>

  <!-- ================= 5. 腕部 RGB-D 相机 ================= -->
  <!-- 相机装在手掌左侧，光轴沿手指方向（夹取时朝下），用来观察夹爪前方的
       物体。相机本体只有视觉和惯量：它没有碰撞体，因此不会伸进夹爪间隙或
       顶到箱子。
       Gazebo 的相机沿 link 的 +x 方向看，所以 camera_link 相对 panda_hand
       绕 y 轴转 -90 度，让 +x 对齐手掌的 +z（手指方向）。光学坐标系按 ROS
       约定（z 向前、x 向右、y 向下）作为 camera_link 的固定子帧，图像的
       frame_id 用这个光学帧；这两个帧都由 robot_state_publisher 从 URDF
       自动发布到 /tf。
       Humble 没有单独的 gazebo_ros_depth_camera 插件；libgazebo_ros_camera.so
       同时支持 sensor type="camera" 和 "depth"。这里用 depth 传感器，所以
       同一个插件会额外发布 /camera/depth/image_raw（32FC1，单位米）、
       /camera/depth/camera_info 和 /camera/points。RGB 话题仍然是
       /camera/image_raw 和 /camera/camera_info。 -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.03"/></geometry>
      <material name="camera_dark"><color rgba="0.10 0.10 0.12 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1.417e-05" iyy="5.417e-06" izz="1.208e-05"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="camera_link"/>
    <origin xyz="0 0.05 0" rpy="0 -1.5707963 0"/>
  </joint>
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
    <sensor name="arm_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10.0</far>
        </clip>
      </camera>
      <!-- camera_name 是话题前缀：在根命名空间下得到 /camera/image_raw、
           /camera/camera_info、/camera/depth/image_raw 和 /camera/points。
           frame_name 与 URDF 里的光学帧一致，TF 由 robot_state_publisher
           提供。min_depth/max_depth 之外的深度值会被插件置为无效点。 -->
      <plugin name="arm_camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
        <min_depth>0.02</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= 6. 机械臂 ros2_control（Gazebo 硬件） ================= -->
  <!-- 只包含 Panda 的 9 个关节；轮子交给差速插件，绝不重复。 -->
  <ros2_control name="PandaGazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="panda_joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_joint7">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- The fingers expose both command interfaces and are switched between
         two controllers at run time. Position (the JTC) opens the gripper and
         pre-closes it to just outside the cube. Effort (the
         JointGroupEffortController) then presses with a constant force: a
         position-only grasp cannot work because GazeboSystem turns a position
         command into Joint::SetPosition, a teleport that shoves the cube away
         instead of squeezing it. -->
    <joint name="panda_finger_joint1">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="panda_finger_joint2">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Ground-truth base pose. The differential-drive plugin's /odom is wheel
       odometry: it integrates wheel rotation and does not know about slip.
       Measured over one 1 m run it ended up ~3 cm and ~2.5 degrees away from
       where the robot really was, which is enough to make the pads pinch only
       the front edge of the 5 cm grasp cube instead of its faces. The grasp
       geometry is therefore computed from this plugin's world pose, not from
       /odom. -->
  <gazebo>
    <plugin name="ground_truth_odometry" filename="libgazebo_ros_p3d.so">
      <!-- The Humble build of this plugin ignores <topic_name> and always
           publishes to "odom"; remap it so it cannot be confused with the
           differential-drive /odom that the drive-distance check reads. -->
      <ros>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- 抓取闭合后把箱子焊到夹爪上。
       gazebo_ros2_control 的关节位置指令在 Gazebo 里表现为瞬移，手指对箱子
       没有持续的法向载荷，实测无论夹紧力多大、箱子多重，摩擦夹持都提不起
       箱子（手指沿箱面上滑，箱子留在原处）。my_robot_grasp_attach 插件在
       收到任务节点的 /grasp_attach 指令后，用物理引擎创建一个 fixed 关节，
       箱子从此跟随 panda_hand 运动；插件在 /grasp_attach/status 上回报结果。
       插件库由 my_robot_grasp_attach 包安装，launch 会把它加进
       GAZEBO_PLUGIN_PATH。 -->
  <gazebo>
    <plugin name="grasp_attach" filename="libgazebo_grasp_attach.so"/>
  </gazebo>

  <!-- ================= 7. 启动 Gazebo 里的 ros2_control ================= -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <!-- xacro 在生成 URDF 时把 $(find ...) 展开成安装目录的绝对路径 -->
      <parameters>$(find my_robot_sim)/config/mobile_manip_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <!-- Must match the launch's robot_state_publisher node name. move_group
           also runs a node called robot_state_publisher, and with two nodes
           of that name the plugin's parameter request can be answered by the
           wrong one (unsanitized description -> controller_manager fails to
           start). A unique name removes the race. -->
      <robot_param_node>mobile_robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

</robot>
