<?xml version="1.0"?>
<robot name="my_car">
  <!-- 1. 车体 -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.25 0.05"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.9 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.25 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005417" iyy="0.013542" izz="0.018542" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- 2. 左轮
       驱动轮必须放在重心前方（x=+0.1），否则重心几乎压在轮轴线上：
       万向轮只承担 ~5% 重量，一刹车/转弯车头就栽下去且回不来。 -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001354" iyy="0.0025" izz="0.001354" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.1 0.15 -0.1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 3. 右轮 -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001354" iyy="0.0025" izz="0.001354" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.1 -0.15 -0.1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 4. 万向轮：Z轴改到 -0.15，保证它跟轮子一样平，不会翘头 -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.18 0 -0.15"/>
  </joint>

  <!-- 摩擦力与驱动 -->
  <gazebo reference="left_wheel"><mu1>10.0</mu1><mu2>10.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>10.0</mu1><mu2>10.0</mu2></gazebo>
  <gazebo reference="caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- 这里已经改成了 10，跟物理时钟对齐！ -->
      <update_rate>10</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <!-- ROS 2 版 gazebo_ros_diff_drive：publish_odom / publish_odom_tf
           默认都是 false，不显式打开就不会创建 /odom 和 odom->base_link 的 TF -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 5. 轮子关节状态。两个轮子是 continuous 关节，robot_state_publisher
       只有在收到 /joint_states 后才会广播 base_link -> left/right_wheel；
       没有人发布关节状态时，RViz 的 RobotModel 会报
       No transform from [left_wheel]/[right_wheel]，轮子直接不显示。 -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="8.333e-05" iyy="8.333e-05" izz="1.25e-04" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- 底盘顶面在 z=+0.025，雷达高 0.05，所以中心放在 z=+0.05；
         x=+0.1 是车头方向。lidar_link 的原点就是扫描平面。 -->
    <origin xyz="0.1 0 0.05"/>
  </joint>

  <!-- 2. Gazebo 雷达传感器插件（这是让雷达发数据的核心！） -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate> <!-- 10Hz -->
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples> <!-- 一圈360度 -->
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>5.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping> <!-- 强制把它变成 /scan 话题 -->
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>